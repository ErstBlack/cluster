#cloud-config
# The same for every node. Each node sets its own hostname and assigns its own address at boot.
# Keeps cloud-init from resetting the hostname runcmd sets.
preserve_hostname: true
users:
  - name: rocky
    groups: [wheel]
    sudo: "ALL=(ALL) NOPASSWD:ALL"
    shell: /bin/bash
    ssh_authorized_keys: ${jsonencode(ssh_keys)}
# Needs the image/ golden image: it carries rke2-server, rke2-agent, keepalived and qemu-guest-agent.
# At boot node-addr assigns this node's address, rke2-elect picks its role, and rke2-configure writes
# /etc/rancher/rke2/config.yaml and starts RKE2 (see the scripts).
write_files:
  - path: /usr/local/sbin/node_addr.py
    permissions: "0755"
    content: ${jsonencode(addr_py)}
  - path: /usr/local/sbin/rke2_elect.py
    permissions: "0755"
    content: ${jsonencode(elect_py)}
  - path: /usr/local/sbin/rke2_configure.py
    permissions: "0755"
    content: ${jsonencode(configure_py)}
  # VIP carries the site prefix (a.b.c.d/NN). GATEWAY and DNS may be empty.
  - path: /etc/rancher/rke2/elect.env
    permissions: "0600"
    content: |
      RKE2_TOKEN=${token}
      VIP=${vip}
      GATEWAY=${gateway}
      DNS=${dns}
      CONTROL_PLANE_COUNT=${control_plane_count}
  # Writes NODE_IP and NODE_IFACE once the node has an address in the VIP's network, assigning one
  # through NetworkManager if it has none.
  - path: /etc/systemd/system/node-addr.service
    content: |
      [Unit]
      Description=Assign this node's address in the VIP's network
      Wants=network-online.target
      After=network-online.target

      [Service]
      Type=oneshot
      RemainAfterExit=yes
      TimeoutStartSec=infinity
      EnvironmentFile=/etc/rancher/rke2/elect.env
      ExecStart=/usr/bin/python3 /usr/local/sbin/node_addr.py

      [Install]
      WantedBy=multi-user.target
  # Ready once the role is recorded. It keeps beaconing for the node's lifetime so late nodes join.
  - path: /etc/systemd/system/rke2-elect.service
    content: |
      [Unit]
      Description=Elect this node's RKE2 role, then beacon it
      Requires=node-addr.service
      After=node-addr.service

      [Service]
      Type=notify
      NotifyAccess=main
      TimeoutStartSec=infinity
      EnvironmentFile=/etc/rancher/rke2/elect.env
      EnvironmentFile=/run/rke2/node.env
      ExecStart=/usr/bin/python3 /usr/local/sbin/rke2_elect.py
      Restart=on-failure
      RestartSec=5

      [Install]
      WantedBy=multi-user.target
  # Writes config.yaml on first boot and enables the role's units on every boot. TimeoutStartSec covers a
  # joiner's wait on the VIP. Restart covers rke2-elect failing before it records a decision.
  - path: /etc/systemd/system/rke2-configure.service
    content: |
      [Unit]
      Description=Write this node's RKE2 config and start its role
      Wants=rke2-elect.service
      After=rke2-elect.service

      [Service]
      Type=oneshot
      RemainAfterExit=yes
      TimeoutStartSec=infinity
      EnvironmentFile=/etc/rancher/rke2/elect.env
      EnvironmentFile=/run/rke2/node.env
      ExecStart=/usr/bin/python3 /usr/local/sbin/rke2_configure.py
      Restart=on-failure
      RestartSec=5

      [Install]
      WantedBy=multi-user.target
  # keepalived's vrrp_script. Policy labels /usr/libexec/keepalived keepalived_unconfined_script_exec_t,
  # so curl runs unconfined instead of needing keepalived_t to reach :9345.
  - path: /usr/libexec/keepalived/rke2-check.sh
    permissions: "0755"
    content: |
      #!/bin/sh
      exec curl -sfk --max-time 2 -o /dev/null https://127.0.0.1:9345/ping
runcmd:
  - [sh, -c, 'hostnamectl set-hostname "node-$(head -c 10 /etc/machine-id)"']
  # If write_files created the directory, it carries its parent's label. This applies the policy label.
  - [restorecon, -R, /usr/libexec/keepalived]
  - [systemctl, daemon-reload]
  # --no-block: rke2-elect waits on the election and rke2-configure on rke2-elect.
  - [systemctl, enable, --now, --no-block, node-addr, rke2-elect, rke2-configure]
